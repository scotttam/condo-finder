# Copy to .env and edit.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
SCRAPE_HOURS=7,11,15,19,23
DEFAULT_MIN_PRICE=2000
DEFAULT_MAX_PRICE=5000
TARGET_CITIES=Portland,Lake Oswego,Beaverton
REQUEST_DELAY_SECONDS=1.5
NOMINATIM_EMAIL=
# Trends page (Claude analysis). Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
TRENDS_MANUAL_RUNS_PER_DAY=5
# Set to 0 to pause the Trends analysis (daily and manual); each run costs about $1.
TRENDS_ENABLED=1
# The HTTPS address people use (Tailscale Funnel). Invite links are built from it.
PUBLIC_URL=
